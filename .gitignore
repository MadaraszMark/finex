# A backend és a frontend saját .gitignore-t használ a saját mappájában.
# Itt csak a közös, gyökérszintű szabályok vannak.

# Operációs rendszer
.DS_Store
Thumbs.db
desktop.ini

# IDE-beállítások a gyökérben
/.idea/
/.vscode/

# Helyi környezeti változók, titkok
.env
.env.*
!.env.example

# Naplófájlok
*.log
# Eclipse workspace-metaadatok (bármelyik mappában)
.metadata/
